# Mailchimp integration for Connect form
# Get these from Mailchimp: Audience → Signup forms → Embedded forms → "Classic"
# Inspect the generated HTML; copy the <form action="..."> URL and the
# `b_<USER_ID>_<LIST_ID>` honeypot field name (inside the display:none div).
#
# Until these are set, the Connect form runs in "demo mode" — it shows the
# success message but does not actually send anywhere.
VITE_MAILCHIMP_ACTION_URL=
VITE_MAILCHIMP_HIDDEN_FIELD=
